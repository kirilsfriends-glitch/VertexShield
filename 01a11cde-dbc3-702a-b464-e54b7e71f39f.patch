+<script id="inj">
+(function(){
+"use strict";
+var LS="wp.history";
+function hist(){try{return JSON.parse(localStorage.getItem(LS)||"[]")}catch(e){return[]}}
+function lineFor(el){
+  var f=el.querySelector(".inj-line");
+  if(!f){f=document.createElement("div");f.className="inj-line";f.setAttribute("style","grid-column:1/-1;font-size:12px;color:var(--muted,#a0a0a8);display:flex;align-items:center;gap:6px;");el.appendChild(f)}
+  return f;
+}
+function render(el,n,ok,pub){
+  var f=lineFor(el);f.textContent="";f.removeAttribute("title");
+  var s=document.createElement("span");
+  if(!pub){s.textContent="Injections: \u2014 (not published)"}
+  else{s.textContent="Injections: ";var b=document.createElement("b");b.textContent=ok?String(n):"\u2026";b.setAttribute("style",ok&&n>0?"color:#4ade80":"color:inherit");s.appendChild(b);
+    f.title="How many times the protected code of this script was actually delivered and executed by a Roblox client. Only real code deliveries count, clicking the link does not."}
+  f.appendChild(s);
+}
+async function poll(){
+  var kids=document.querySelectorAll("#histList > .item");
+  if(!kids.length)return;
+  var h=hist();
+  var ids=[],pairs=[];
+  for(var i=0;i<kids.length;i++){
+    var e=h[i],sid=e&&e.serverId;
+    if(sid&&/^[0-9a-f]{8}$/i.test(sid)){ids.push(sid);pairs.push([kids[i],sid])}
+    else render(kids[i],0,true,false);
+  }
+  if(!ids.length)return;
+  try{
+    var r=await fetch("/api/inj?ids="+encodeURIComponent(ids.join(",")),{headers:{accept:"application/json"}});
+    if(!r.ok)return;
+    var j=await r.json();
+    for(var k=0;k<pairs.length;k++){
+      var id=pairs[k][1],n=j[id];
+      render(pairs[k][0],typeof n==="number"?n:0,true,true);
+    }
+  }catch(e){}
+}
+function boot(){
+  var l=document.getElementById("histList");
+  if(l&&window.MutationObserver)new MutationObserver(function(){poll()}).observe(l,{childList:true});
+  setInterval(poll,5000);
+  poll();
+}
+if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);else boot();
+})();
